# Copy to .env.local and fill in only what you use. Every key is optional: the site builds
# and runs with none of them. .env.local is gitignored; the pre-commit hook refuses key-shaped
# strings anywhere else. For deployments, `npx vercel env add NAME production` per key.
# The dev-only /settings page (Connections) tests each one.

# ---- Intelligence: alt text, SEO descriptions, content review ----------------------------
# One of these, chosen by `intelligence.provider` in site.config.ts (default: anthropic).
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Vercel AI Gateway: one key for every model. https://vercel.com/docs/ai-gateway/authentication
AI_GATEWAY_API_KEY=

# ---- Photos: only for the sources listed in `photos.sources` ----------------------------
# Unsplash: Your apps → Keys → Access Key (not the Secret key). https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Pixelfed: optional; public accounts need no token. Settings → Applications.
PIXELFED_TOKEN=
# Immich: Account Settings → API Keys (album.read, asset.read, sharedLink.read, sharedLink.create).
IMMICH_API_KEY=
# PhotoPrism: Settings → Account → Apps and Devices (not needed in public mode).
PHOTOPRISM_TOKEN=
# Glass needs no key.

# ---- About page: the GitHub contribution calendar ---------------------------------------
# A fine-grained token with public read access is enough. https://github.com/settings/tokens
GITHUB_TOKEN=

# ---- Publishing: newsletter and likes (`publishing.newsletter`, `publishing.likes`) ------
# Buttondown: Settings → API. https://buttondown.com/requests
BUTTONDOWN_API_KEY=
# Neon Postgres connection string for likes; run `npm run db:push` once after setting it.
DATABASE_URL=
# Resend, for the like-notification email; RESEND_FROM defaults to onboarding@resend.dev.
RESEND_API_KEY=

# Optional. Vercel sends it as a bearer token with the daily scheduled-posts cron; set it on the
# project (npx vercel env add CRON_SECRET production) and nobody else can trigger the route.
CRON_SECRET=
RESEND_FROM=

# ---- Designs: the shared password for gated case studies ---------------------------------
# Server-enforced. Generate one: `openssl rand -hex 32`
DESIGN_PASSWORD=


# ---- Local conveniences ------------------------------------------------------------------
# Your Vercel project, https://vercel.com/<team>/<project>: adds two palette rows in dev.
NEXT_PUBLIC_VERCEL_DASHBOARD_URL=
# Pin the canonical origin. Unset, the build uses the Vercel project's production domain.
NEXT_PUBLIC_SITE_URL=
