# Obsidian plugin settings can hold API keys (the Text Generator plugin does); they never
# ship. The one exception is the git plugin's settings, which are the vault's publish loop
# (auto commit and push every ten minutes) and hold no key; scripts/check-secrets.mjs refuses
# that file the moment a password or token appears in it (the mobile app stores one there).
.obsidian/plugins/*/data.json
!.obsidian/plugins/obsidian-git/data.json
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Drafts render in development only and never leave this machine: unfinished posts,
# captured articles kept for reference, anything not ready to publish.
src/content/writing/drafts/*
!src/content/writing/drafts/_placeholder.mdx

# Local symlink for Obsidian image preview (images/ -> public/images/)
/images

# Claude Code internal agent worktrees + local project skills
.claude/worktrees/
# .claude/skills ships with the template: setup, new-post, new-page are the product

# Migration source archives (one-time imports, not website assets)
Tumblr/
Squarespace.xml
blot/

# iPhone bezel frame templates (local baking assets for scripts/bake-bezel.mjs)
bezels/

# Vercel local project link (created by vercel link)
.vercel

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# Lighthouse CI local reports (generated artifacts, not source)
/.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts
extension-safari/**/build

# agent tooling droppings — never commit
.agents/
brag-output/
skills-lock.json

# analysis builds (see next.config.mjs distDir override) — MUST stay ignored:
# Tailwind's scanner respects .gitignore, and scanning built chunks feeds it
# garbage class candidates that corrupt the generated CSS (2026-08-28 incident)
.next-analyze/

# QA harness outputs (regenerated by qa/run.mjs and qa/build-matrix.mjs)
/qa/registry.json
/qa/build-matrix.json

# Any alternate dist dir (NEXT_DIST_DIR=.next-foo): Tailwind scans unignored chunks and 500s the site
/.next-*/
